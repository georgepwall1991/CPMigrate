# Project Identification
sonar.projectKey=georgepwall1991_CPMigrate
sonar.organization=georgepwall1991

# Project Metadata
sonar.projectName=CPMigrate
sonar.projectVersion=3.22.0

# Source Configuration
sonar.sources=CPMigrate
sonar.tests=CPMigrate.Tests

# Exclusions
sonar.exclusions=**/obj/**,**/bin/**,**/*.Designer.cs,**/nupkg/**
sonar.coverage.exclusions=**/*.Tests/**,**/Program.cs

# .NET Configuration
sonar.dotnet.excludeGeneratedCode=true
sonar.cs.opencover.reportsPaths=**/coverage.opencover.xml
sonar.cs.vstest.reportsPaths=**/*.trx

# Quality Gate
sonar.qualitygate.wait=true
