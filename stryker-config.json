{
  "stryker-config": {
    "project": "CPMigrate/CPMigrate.csproj",
    "test-projects": [
      "CPMigrate.Tests/CPMigrate.Tests.csproj"
    ],
    "test-case-filter": "FullyQualifiedName~CPMigrate.Tests.Licensing|FullyQualifiedName~LicenseAnalyzerTests|FullyQualifiedName~LicenseRisk|FullyQualifiedName~LicensesRequested|FullyQualifiedName~LicensesNotRequested|FullyQualifiedName~LicensesWithoutAnalyze",
    "mutate": [
      "**/Licensing/**/*.cs",
      "**/Analyzers/LicenseAnalyzer.cs"
    ],
    "thresholds": {
      "high": 90,
      "low": 90,
      "break": 90
    },
    "concurrency": 2,
    "reporters": [
      "html",
      "json",
      "cleartext"
    ],
    "ignore-methods": [
      "*ToString",
      "*ConfigureAwait"
    ]
  }
}
