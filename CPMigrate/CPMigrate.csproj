<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>cpmigrate</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <OutputType>EXE</OutputType>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>CPMigrate</PackageId>
    <Authors>George Wall</Authors>
    <Company>George Wall</Company>
    <Product>CPMigrate</Product>
    <Title>CPMigrate — NuGet Central Package Management Migration &amp; Dependency Analysis CLI</Title>
    <Description>Migrate .NET solutions to NuGet Central Package Management (CPM). Generate Directory.Packages.props, analyze dependency health (version drift, transitive conflicts, vulnerabilities), auto-fix package issues, unify Directory.Build.props, and update NuGet packages with test verification and rollback — including --bisect to keep the largest green subset. --remediate clears CVEs with the smallest version bump that fixes them, test-verified and re-scanned to prove it.</Description>
    <PackageReleaseNotes>3.65.0 closes the loop on security findings. New --remediate clears known advisories by moving each vulnerable package to the LOWEST version that fixes it - not the newest - then runs dotnet test, rolls back on red, honours --bisect to keep the largest green subset, and re-scans afterwards so the receipt reports what a fresh scan found rather than what the plan intended. Findings still come from dotnet list package --vulnerable; the fix version comes from looking that exact advisory up at OSV.dev, which is also why the receipt can finally print a CVE number instead of an advisory URL. Major-version fixes are reported and withheld unless --allow-major is passed, and an unreachable advisory database exits 8 rather than falling back to a latest-version bump. New exit code 10 (RemediationIncomplete) marks a run where an advisory survived; output schema 1.10.0 adds the additive remediation receipt with its measured advisoriesAfter.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://georgepwall1991.github.io/CPMigrate/</PackageProjectUrl>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Version>3.65.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/georgepwall1991/CPMigrate</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <ApplicationIcon>cpmigrate.ico</ApplicationIcon>
    <PackageTags>nuget;central-package-management;CPM;CentralPackageManagement;directory-packages-props;Directory.Build.props;dotnet-tool;cli;dependency-analysis;package-updates;rollback;bisect;monorepo;slnx;dotnet;package-management;migrator;version-drift;vulnerability;centralised;remediation;cve;security;advisory;osv</PackageTags>
    <PackageIcon>nuget-icon.png</PackageIcon>
    <!-- Static Analysis -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Buildalyzer" />
    <PackageReference Include="CommandLineParser" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.VisualStudio.SolutionPersistence" />
    <PackageReference Include="NuGet.Versioning" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Spectre.Console" />
    <!-- Code Analysis -->
    <PackageReference Include="SonarAnalyzer.CSharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Explicit references to override vulnerable transitive dependencies -->
    <PackageReference Include="Microsoft.Build" />
    <PackageReference Include="Microsoft.Build.Tasks.Core" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" />
    <!-- These System.* packages are pinned in Directory.Packages.props to override older transitive versions from Microsoft.Build / Buildalyzer -->
    <PackageReference Include="System.CodeDom" />
    <PackageReference Include="System.Configuration.ConfigurationManager" />
    <PackageReference Include="System.Diagnostics.EventLog" />
    <PackageReference Include="System.Formats.Nrbf" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" />
    <PackageReference Include="System.Resources.Extensions" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="nuget-icon.png" Pack="true" PackagePath="\" />
    <None Include="..\assets\*.svg" Pack="true" PackagePath="assets\" />
  </ItemGroup>
</Project>
