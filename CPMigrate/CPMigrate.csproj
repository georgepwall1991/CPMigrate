<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>cpmigrate</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <OutputType>EXE</OutputType>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>CPMigrate</PackageId>
    <Authors>George Wall</Authors>
    <Company>George Wall</Company>
    <Product>CPMigrate</Product>
    <Title>CPMigrate — NuGet Central Package Management Migration &amp; Dependency Analysis CLI</Title>
    <Description>Migrate .NET solutions to NuGet Central Package Management (CPM). Generate Directory.Packages.props, analyze dependency health (version drift, transitive conflicts, vulnerabilities), auto-fix package issues, unify Directory.Build.props, and update NuGet packages with test verification and rollback — including --bisect to keep the largest green subset. --remediate clears CVEs with the smallest version bump that fixes them, test-verified and re-scanned to prove it.</Description>
    <PackageReleaseNotes>3.66.0 makes --update a well-formed command. Under --output Json it now emits the update document (schema 1.20.0) - both versions, a status token (updated, alreadyLatest, checkFailed, dryRun, nonInteractive, declined, failed), the forced/dryRun inputs, and what a failed dotnet tool update said - where previously a CI consumer got empty stdout. --force is the consent the prompt would otherwise collect and the first unattended self-update path; --dry-run is honoured for the first time rather than silently running a real update; and the AnsiConsole spinner that wrote frames onto stdout is gated on interactivity. Also in this train since the 3.65.0 notes were cut: --tree, --status, --doctor, --list-backups, --prune-backups, --init, --explain, --unify-props, --rollback, and --fix all emit their JSON documents (schemas 1.11.0-1.19.0), five more rules are auto-fixable, .cpmigrate.json carries the analysis toggles, and --fix-rule restricts --fix to named rules.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://georgepwall1991.github.io/CPMigrate/</PackageProjectUrl>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Version>3.66.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/georgepwall1991/CPMigrate</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <ApplicationIcon>cpmigrate.ico</ApplicationIcon>
    <PackageTags>nuget;central-package-management;CPM;CentralPackageManagement;directory-packages-props;Directory.Build.props;dotnet-tool;cli;dependency-analysis;package-updates;rollback;bisect;monorepo;slnx;dotnet;package-management;migrator;version-drift;vulnerability;centralised;remediation;cve;security;advisory;osv</PackageTags>
    <PackageIcon>nuget-icon.png</PackageIcon>
    <!-- Static Analysis -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Buildalyzer" />
    <PackageReference Include="CommandLineParser" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.VisualStudio.SolutionPersistence" />
    <PackageReference Include="NuGet.Versioning" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Spectre.Console" />
    <!-- Code Analysis -->
    <PackageReference Include="SonarAnalyzer.CSharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Explicit references to override vulnerable transitive dependencies -->
    <PackageReference Include="Microsoft.Build" />
    <PackageReference Include="Microsoft.Build.Tasks.Core" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" />
    <!-- These System.* packages are pinned in Directory.Packages.props to override older transitive versions from Microsoft.Build / Buildalyzer -->
    <PackageReference Include="System.CodeDom" />
    <PackageReference Include="System.Configuration.ConfigurationManager" />
    <PackageReference Include="System.Diagnostics.EventLog" />
    <PackageReference Include="System.Formats.Nrbf" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" />
    <PackageReference Include="System.Resources.Extensions" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="nuget-icon.png" Pack="true" PackagePath="\" />
    <None Include="..\assets\*.svg" Pack="true" PackagePath="assets\" />
  </ItemGroup>
</Project>
